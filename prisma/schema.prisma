generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Campus {
  id          Int        @id @default(autoincrement())
  name        String
  description String
  address     String
  latitude    Decimal
  longitude   Decimal
  createdAt   DateTime   @default(now()) @map("created_at")
  updatedAt   DateTime   @updatedAt @map("updated_at")
  buildings   Building[]
  maps        Map[]

  @@unique([name])
  @@map("campi")
}

model Building {
  id          Int      @id @default(autoincrement())
  campusId    Int      @map("campus_id")
  name        String
  description String
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  campus Campus @relation(fields: [campusId], references: [id])

  floors Floor[]
  maps   Map[]

  @@unique([name, campusId])
  @@index([campusId])
  @@map("buildings")
}

model Floor {
  id         Int      @id @default(autoincrement())
  buildingId Int      @map("building_id")
  name       String
  number     Int
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  building Building @relation(fields: [buildingId], references: [id])
  rooms    Room[]
  maps     Map[]

  @@unique([buildingId, number])
  @@unique([buildingId, name])
  @@map("floors")
}

model Room {
  id            Int      @id @default(autoincrement())
  floorId       Int      @map("floor_id")
  mapLocationId Int      @map("map_location_id")
  name          String
  roomTypeId    Int      @map("room_type_id")
  capacity      Int
  latitude      Decimal?
  longitude     Decimal?
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  floor          Floor           @relation(fields: [floorId], references: [id])
  roomType       RoomType        @relation(fields: [roomTypeId], references: [id])
  mapLocation    MapLocation     @relation(fields: [mapLocationId], references: [id])
  classSchedules ClassSchedule[]

  @@unique([floorId, name])
  @@index([roomTypeId])
  @@index([mapLocationId])
  @@map("rooms")
}

model RoomType {
  id          Int      @id @default(autoincrement())
  name        String
  description String
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")
  rooms       Room[]

  @@unique([name])
  @@map("room_types")
}

model Map {
  id          Int      @id @default(autoincrement())
  campusId    Int      @map("campus_id")
  buildingId  Int?     @map("building_id")
  floorId     Int?     @map("floor_id")
  name        String
  description String
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  campus       Campus        @relation(fields: [campusId], references: [id])
  building     Building?     @relation(fields: [buildingId], references: [id])
  floor        Floor?        @relation(fields: [floorId], references: [id])
  mapLocations MapLocation[]

  @@unique([campusId, name])
  @@index([buildingId])
  @@index([floorId])
  @@map("maps")
}

model MapLocation {
  id        Int      @id @default(autoincrement())
  mapId     Int      @map("map_id")
  name      String
  x         Decimal
  y         Decimal
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  map   Map    @relation(fields: [mapId], references: [id])
  rooms Room[]

  @@unique([mapId, name])
  @@map("map_locations")
}

model Course {
  id          Int       @id @default(autoincrement())
  name        String
  description String
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")
  subjects    Subject[]

  @@unique([name])
  @@map("courses")
}

model Subject {
  id          Int    @id @default(autoincrement())
  courseId    Int    @map("course_id")
  professorId Int    @map("professor_id")
  name        String
  description String

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  course         Course          @relation(fields: [courseId], references: [id])
  professor      Professor       @relation(fields: [professorId], references: [id])
  classSchedules ClassSchedule[]

  @@unique([courseId, name])
  @@index([professorId])
  @@map("subjects")
}

model ClassGroup {
  id       Int     @id @default(autoincrement())
  semester Int
  year     Int
  isActive Boolean @default(true) @map("is_active")

  createdAt      DateTime        @default(now()) @map("created_at")
  updatedAt      DateTime        @updatedAt @map("updated_at")
  classSchedules ClassSchedule[]

  @@index([year, semester])
  @@map("class_groups")
}

model Professor {
  id        Int     @id @default(autoincrement())
  name      String
  email     String  @unique
  telephone String?

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  subjects  Subject[]

  @@map("professors")
}

model ClassSchedule {
  id           Int       @id @default(autoincrement())
  classGroupId Int       @map("class_group_id")
  subjectId    Int       @map("subject_id")
  roomId       Int       @map("room_id")
  dayOfWeek    DayOfWeek @map("day_of_week")
  startTime    DateTime  @db.Time(0)
  endTime      DateTime  @db.Time(0)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  room       Room       @relation(fields: [roomId], references: [id])
  classGroup ClassGroup @relation(fields: [classGroupId], references: [id])
  subject    Subject    @relation(fields: [subjectId], references: [id])

  classSessions ClassSession[]

  @@unique([roomId, dayOfWeek, startTime])
  @@index([classGroupId])
  @@index([subjectId])
  @@map("class_schedules")
}

model ClassSession {
  id              Int                @id @default(autoincrement())
  classScheduleId Int                @map("class_schedule_id")
  date            DateTime           @db.Date
  status          ClassSessionStatus @default(SCHEDULED)
  startTime       DateTime           @db.Time(0)
  endTime         DateTime           @db.Time(0)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  classSchedule ClassSchedule @relation(fields: [classScheduleId], references: [id])

  @@unique([classScheduleId, date])
  @@index([date])
  @@map("class_sessions")
}

enum DayOfWeek {
  MONDAY
  TUESDAY
  WEDNESDAY
  THURSDAY
  FRIDAY
  SATURDAY
  SUNDAY
}

enum ClassSessionStatus {
  SCHEDULED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}
